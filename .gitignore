# Selected, reviewed derivatives explicitly requested for private GitHub reading.
# Original videos and service manifests remain under ignored media/.
!reviews/assets/
!reviews/assets/**/
!reviews/assets/**/*.png
!reviews/assets/**/*.jpg
!reviews/assets/**/*.jpeg
!reviews/assets/**/*.gif

# The publication checkout also preserves selected derivatives at legacy URLs.
!materials/reviews/assets/
!materials/reviews/assets/**/
!materials/reviews/assets/**/*.png
!materials/reviews/assets/**/*.jpg
!materials/reviews/assets/**/*.jpeg
!materials/reviews/assets/**/*.gif

# Only selected owned frame replays for this programme; source videos stay ignored.
!reviews/assets/program-2026-10-05/*.mp4
!materials/reviews/assets/program-2026-10-05/*.mp4

# React publication build and local packages; committed source is website/.
website/node_modules/
website/dist/
website/src/project-data.json
